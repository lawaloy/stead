DATABASE_URL="postgresql://stead:stead@localhost:5432/stead?schema=public"
# Generate separate values for all secrets (for example: openssl rand -base64 32).
JWT_SECRET="__REPLACE_ME__"
JWT_EXPIRES_IN="7d"
NOTIFICATION_PAYLOAD_ENCRYPTION_KEY="__REPLACE_ME__"
AUTH_DEVICE_IDENTIFIER_SECRET="__REPLACE_ME__"

# Comma-separated authenticated user IDs permitted to access inspection APIs.
AUTH_INSPECTION_OPERATOR_USER_IDS=""

# OTP abuse controls. Device IDs are optional client signals; only keyed hashes
# are persisted. Older clients remain protected by the phone and IP limits.
AUTH_OTP_REQUEST_LIMIT_PER_HOUR="10"
AUTH_OTP_REQUEST_LIMIT_PER_IP_PER_HOUR="20"
AUTH_OTP_REQUEST_LIMIT_PER_DEVICE_PER_HOUR="10"
AUTH_OTP_RESEND_COOLDOWN_MS="60000"
AUTH_OTP_MAX_VERIFY_ATTEMPTS="5"
AUTH_OTP_VERIFY_FAILURE_LIMIT_PER_IP_WINDOW="10"
AUTH_OTP_VERIFY_FAILURE_LIMIT_PER_DEVICE_WINDOW="8"
AUTH_OTP_VERIFY_FAILURE_WINDOW_MS="900000"

# Use "dev" for local development without third-party SMS credentials.
# Use "twilio" or "termii" for live provider-backed delivery.
SMS_PROVIDER="dev"
DEV_EXPOSE_OTP="true"

# Twilio
# Set SMS_PROVIDER="twilio" to use this provider.
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_auth_token"
TWILIO_FROM="+15551234567"
# Or use a Messaging Service SID instead of TWILIO_FROM
TWILIO_MESSAGING_SERVICE_SID="MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Termii (Nigeria-focused alternative)
# Set SMS_PROVIDER="termii" to use this provider.
TERMII_API_KEY="your_termii_api_key"
TERMII_SENDER_ID="STEAD"
TERMII_CHANNEL="generic"
