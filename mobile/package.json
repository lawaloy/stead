{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "engines": {
    "node": "^22.18.0 || ^24.0.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "@types/jest",
        "expo",
        "expo-constants",
        "expo-router",
        "jest",
        "react",
        "react-dom",
        "react-native-gesture-handler",
        "react-native-safe-area-context",
        "react-native-screens"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "test": "node --require ../tools/jest-resolver-fallback.cjs node_modules/jest/bin/jest.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "expo export --platform web --output-dir dist"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "axios": "1.19.0",
    "expo": "~57.0.8",
    "expo-constants": "~57.0.2",
    "expo-crypto": "~57.0.2",
    "expo-linking": "~57.0.8",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "image-size": "file:vendor/image-size-compat",
    "libphonenumber-js": "^1.13.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~3.1.0",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-screens": "~4.27.0",
    "react-native-web": "^0.21.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "30.0.0",
    "@types/react": "~19.2.17",
    "@typescript-eslint/parser": "^8.68.0",
    "axios-mock-adapter": "^2.1.0",
    "babel-preset-expo": "~57.0.1",
    "eslint": "^10.9.1",
    "eslint-config-expo": "~57.0.2",
    "jest": "~30.4.2",
    "jest-util": "^30.4.1",
    "test-renderer": "^1.2.0",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "js-yaml": "4.3.1",
    "uuid": "14.0.1",
    "node-forge": "1.4.0",
    "yaml": "2.8.3",
    "handlebars": "4.7.9",
    "postcss": "8.5.26"
  },
  "private": true
}
