{
  "name": "stead-repository",
  "private": true,
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "setup": "npm ci && npm ci --prefix api && npm ci --prefix mobile",
    "bootstrap": "npm run setup && npm run dev:prepare",
    "env:init": "node scripts/local-workflow.mjs env:init",
    "db:start": "node scripts/local-workflow.mjs db:start",
    "db:stop": "node scripts/local-workflow.mjs db:stop",
    "dev:prepare": "node scripts/local-workflow.mjs dev:prepare",
    "dev:api": "npm --prefix api run start:dev",
    "dev:mobile": "npm --prefix mobile run start",
    "format": "prettier --write .",
    "format:check": "node scripts/format-check.mjs",
    "workflows:check": "node scripts/workflow-checks.mjs",
    "automation:test": "node --test scripts/*.test.mjs",
    "toolchain:check": "node scripts/toolchain.mjs",
    "tools:install:maestro": "node scripts/install-maestro.mjs",
    "tools:install:android": "node scripts/android-sdk.mjs",
    "native:setup:ios": "node scripts/ios-setup.mjs",
    "test:native:android:managed": "node scripts/android-emulator.mjs",
    "test:native:android:container": "node scripts/android-container.mjs",
    "native:doctor": "node scripts/native-workflow.mjs doctor",
    "native:build:android": "node scripts/native-workflow.mjs build --platform android",
    "native:build:ios": "node scripts/native-workflow.mjs build --platform ios",
    "test:native:android": "node scripts/native-workflow.mjs test --platform android",
    "test:native:ios": "node scripts/native-workflow.mjs test --platform ios",
    "verify:local": "node scripts/native-workflow.mjs verify",
    "security:codeql:local": "node scripts/codeql-local.mjs",
    "dependencies:check": "node scripts/dependency-checks.mjs",
    "mobile:compatibility:check": "node scripts/dependency-checks.mjs mobile-compatibility",
    "hooks:install": "node scripts/pre-push-verification.mjs install",
    "lint": "npm --prefix api run lint && npm --prefix mobile run lint",
    "lint:fix": "npm --prefix api run lint:fix && npm --prefix mobile run lint:fix",
    "contracts:check": "npm --prefix api run contracts:check",
    "typecheck": "npm --prefix api run typecheck && npm --prefix mobile run typecheck",
    "test": "npm --prefix api run test -- --runInBand && npm --prefix mobile run test -- --runInBand",
    "build": "npm --prefix api run build && npm --prefix mobile run build",
    "check": "npm run format:check && npm run workflows:check && npm run automation:test && npm run lint",
    "verify": "npm run toolchain:check && npm run check && npm run contracts:check && npm run typecheck && npm run test && npm run build",
    "test:e2e:local": "node scripts/local-workflow.mjs test:e2e",
    "test:journey:local": "node scripts/local-workflow.mjs test:journey",
    "verify:full": "npm run verify && npm run test:e2e:local && npm run test:journey:local"
  },
  "devDependencies": {
    "cross-spawn": "7.0.6",
    "prettier": "3.9.6"
  }
}
